

nml/templates/diesel.nml.j2: nml/templates/item.nml.j2

src/Diesel/%_property.pnml: nml/templates/property.pnml.j2 nml/items/Diesel/%.yml nml/data/geoscheme.yml
	$(_E) "[J2]" $(@F)
	$(_V) $(PYTHON) tools/j2.py -o $@ $^ 

src/Diesel/%_graphics.pnml: nml/templates/graphics.pnml.j2 nml/items/Diesel/%.yml
	$(_E) "[J2]" $(@F)
	$(_V) $(PYTHON) tools/j2.py -o $@ $^ 

src/Diesel/%_item.pnml: nml/templates/item.pnml.j2 nml/items/Diesel/%.yml
	$(_E) "[J2]" $(@F)
	$(_V) $(PYTHON) tools/j2.py -o $@ $^ 

YAML_DIESEL_FILES = $(wildcard nml/items/Diesel/*.yml)
PNML_DIESEL_FILES_P = $(foreach x,$(YAML_DIESEL_FILES),$(patsubst nml/items/Diesel/%.yml,src/Diesel/%_property.pnml,$x))
PNML_DIESEL_FILES_G = $(foreach x,$(YAML_DIESEL_FILES),$(patsubst nml/items/Diesel/%.yml,src/Diesel/%_graphics.pnml,$x))
PNML_DIESEL_FILES_I = $(foreach x,$(YAML_DIESEL_FILES),$(patsubst nml/items/Diesel/%.yml,src/Diesel/%_item.pnml,$x))

PNML_FILES = $(PNML_DIESEL_FILES_P) $(PNML_DIESEL_FILES_G) $(PNML_DIESEL_FILES_I)
