
.DELETE_ON_ERROR:

DATA_FILES = $(wildcard nml/data/*.yml)

nml/templates/train/engine/diesel.pnml.j2: nml/templates/train/engine/base.pnml.j2 nml/templates/train/train.pnml.j2
	$(_V) touch $@

src/Diesel/%.pnml: nml/templates/train/engine/diesel.pnml.j2 nml/items/Diesel/%.yml $(DATA_FILES)
	$(_E) "[J2]" $(@F)
	$(_V) minijinja-cli --strict -o $@ $^ 

YAML_DIESEL_FILES = $(wildcard nml/items/Diesel/*.yml)
PNML_DIESEL_FILES = $(foreach x,$(YAML_DIESEL_FILES),$(patsubst nml/items/Diesel/%.yml,src/Diesel/%.pnml,$x))

