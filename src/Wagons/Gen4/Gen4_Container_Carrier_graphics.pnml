#define GEN4_CONTAINER_LIVERY(NAME, L, OFFSET) \
	spriteset(spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S1, format_string("build/gfx/Gen4_Container_Carrier_%s.png", #NAME)) { \
		template_2cc_wagons(OFFSET, 1) \
	} \
	spriteset(spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S2, format_string("build/gfx/Gen4_Container_Carrier_%s.png", #NAME)) { \
		template_2cc_wagons(OFFSET, 27) \
	} \
	spriteset(spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S3, format_string("build/gfx/Gen4_Container_Carrier_%s.png", #NAME)) { \
		template_2cc_wagons(OFFSET, 53) \
	} \
	spriteset(spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S4, format_string("build/gfx/Gen4_Container_Carrier_%s.png", #NAME)) { \
		template_2cc_wagons(OFFSET, 79) \
	} \
	spritegroup spritegroup_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L { \
		loading: [spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S1, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S2, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S3, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S4]; \
		loaded: [spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S1, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S2, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S3, spriteset_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _ ## L ## _S4]; \
	}

#define GEN4_CONTAINER(NAME) \
	GEN4_CONTAINER_LIVERY(NAME, L1, 1) \
	/*GEN4_CONTAINER_LIVERY(NAME, L2, 179)*/ \
	/*GEN4_CONTAINER_LIVERY(NAME, L3, 357)*/ \
	/*GEN4_CONTAINER_LIVERY(NAME, L4, 535)*/ \
	random_switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _livery) { \
		7: spritegroup_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _L1; \
		/*1: spritegroup_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _L2;*/ \
		/*1: spritegroup_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _L3;*/ \
		/*1: spritegroup_wagon_Narrow_Gen4_Container_Carrier_ ## NAME ## _L4;*/ \
	}


/*
* PURCHASE
*/

PURCHASE_SPRITESET_WAGON(wagon_Narrow_Gen4_Container_Carrier, "gfx/Wagons/Gen4/Container_Carrier/Purchase.png", 1, 1)

/*
* CARGO VARIATIONS
*/

GEN4_CONTAINER(Container_1)
GEN4_CONTAINER(Container_2)
GEN4_CONTAINER(Container_3)

random_switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_Container_livery) {
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Container_1_livery;
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Container_2_livery;
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Container_3_livery;
}

GEN4_CONTAINER(Refrigerated_1)
GEN4_CONTAINER(Refrigerated_2)
GEN4_CONTAINER(Refrigerated_3)

random_switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery) {
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_1_livery;
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_2_livery;
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_3_livery;
}

//Goods have multiple liveries
random_switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_Goods_livery) {
	7: switch_wagon_Narrow_Gen4_Container_Carrier_Container_livery;
	2: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;
	// 1: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
}

// Liquids use tanktainers
switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_is_liquid, hasbit(cargo_type_in_veh, CC_LIQUID)) {
	// 1: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	switch_wagon_Narrow_Gen4_Container_Carrier_Container_livery;
}

// Refrigerated cargoes use reefer
switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_is_refrigerated, hasbit(cargo_type_in_veh, CC_REFRIGERATED)) {
	1: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;
	switch_wagon_Narrow_Gen4_Container_Carrier_is_liquid;
}

switch(FEAT_TRAINS, SELF, switch_wagon_Narrow_Gen4_Container_Carrier_cargo_selection, cargo_type_in_veh) {

	/* Food */
	FOOD: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;
	FRUT: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;
	FZDR: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;
	FISH: switch_wagon_Narrow_Gen4_Container_Carrier_Refrigerated_livery;

	/* Liquid */
	// RUBR: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// WATR: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// COLA: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// PLST: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// BEER: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// DYES: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// PETR: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// PLAS: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;
	// RFPR: switch_wagon_Narrow_Gen4_Container_Carrier_Tanktainer_livery;

	/* Goods */
	// GOOD: switch_wagon_Narrow_Gen4_Container_Carrier_Goods_livery;

	/* Fallback by FRAX class */
	switch_wagon_Narrow_Gen4_Container_Carrier_is_refrigerated;
}

//Add defined switches 

ENGINECAPACITYSWITCH(VEHIDCODE)

RUNNINGCOSTENGINESWITCH

PURCHASETEXTSWITCH