#include "../undefine_properties.pnml"

#define VEHIDCODE {{ item.id }}
#define ITEM item_{{ item.id }}
#define NAME string(str_{{ item.id }})

#define VEHICLE_REGION  REGION(SOUTHAMERICA,NOREGION,NOCONCEPT)
#define VEHICLE_GAUGE   NAR_{{ item.gauge | upper }}
#define VEHICLE_MAKER   MAKER_{{ item.builders[0] | upper }}
#define VEHICLE_POWER   {{ item.propulsion | upper }}
#define VEHICLE_COUNTRY {{ item.country }}

{%- set region = REGIONS[item.country] %}

#define VEHICLE_BADGES \
    "flag/{{ item.country }}", \
    {%- if region is defined %}
    "region/{{ region[0] }}", \
    {% if region | length == 2 %}"region/{{ region[0] }}/{{ region[1] }}", \{% endif %}
    {% endif -%}
    "power/{{ item.propulsion }}", \
    "railgauge/narrow/{{ item.gauge }}", \
    {% for builder in item.builders -%}
    "builder/{{ builder }}"{% if not loop.last %}, \{% endif %}
    {%- endfor %}

#define INTRODUCTION_YEAR {{ item.life.start }}
#define MODEL_LIFE 45
#define VEHICLE_LIFE 40

#define SPEED {{ item.speed }}
#define POWER {{ item.power }}
#define WEIGHT {{ item.weight }}
#define TE_COEFFICIENT {{ item.te_coefficient }}

{% if units is defined -%}
#define ARTICULATED {{ units | length }}
#define LENGTH {{ units[0].length }}
#define ACTUAL_LENGTH {{ units | map(attribute="length") | sum }}
{% elif gfx.length > 8 %}
#define ARTICULATED {{ gfx.length % 8 }}
#define LENGTH {{ 8 if gfx.length > 8 else gfx.length }}
#define ACTUAL_LENGTH {{ gfx.length }}
{% else %}
#define LENGTH {{ 8 if gfx.length > 8 else gfx.length }}
#define ACTUAL_LENGTH {{ gfx.length }}
{%- endif %}

#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC)
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER)

#include "../_CodeSupport/item_defaults.pnml"
