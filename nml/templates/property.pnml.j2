#include "../undefine_properties.pnml"

#define VEHIDCODE {{ item.id }}
#define ITEM item_{{ item.id }}
#define NAME string(str_{{ item.id }})

{%- set region = REGIONS[item.country] %}
{% if region.region == "europe" %}
{% set climate = "%sEUROPE" | format(region.subregion | upper) %}
{% elif region.region == "america" %}
    {% if region.subregion == "northern" %}
    {% set climate = "NORTHAMERICA" %}
    {% else %}
    {% set climate = "SOUTHAMERICA" %}
    {% endif %}
{% else %}
{% set climate = region.region | upper %}
{% endif -%}

#define VEHICLE_REGION  REGION({{ climate }},NOREGION,NOCONCEPT)
#define VEHICLE_GAUGE   NAR_{{ item.gauge | upper }}
#define VEHICLE_MAKER   MAKER_{{ item.builders[0] | upper }}
#define VEHICLE_POWER   {{ item.propulsion | upper }}
#define VEHICLE_COUNTRY {{ item.country }}

#define VEHICLE_BADGES \
    "flag/{{ item.country }}", \
    {%- if region is defined %}
    "region/{{ region.region }}", \
    {% if region.subregion is defined %}"region/{{ region.region }}/{{ region.subregion }}", \{% endif %}
    {% endif -%}
    "power/{{ item.propulsion | replace("_", "/") }}", \
    "railgauge/narrow/{{ item.gauge }}", \
    {% for builder in item.builders -%}
    "builder/{{ builder }}"{% if not loop.last %}, \
    {% endif %}
    {%- endfor %}

#define INTRODUCTION_YEAR {{ item.life.start }}
{%- if item.life.end is defined %}
#define MODEL_LIFE {{ item.life.end - item.life.start }}
{%- else %}
#define MODEL_LIFE VEHICLE_NEVER_EXPIRES
{%- endif %}
#define VEHICLE_LIFE 40

{% if cargo is defined %}
{% if cargo.loading_speed is defined %}
#define LOADINGSPEED {{ cargo.loading_speed }}
{% endif %}
{% if cargo.cargodef is defined %}
#define CARGODEF {{ cargo.cargodef }}
{% endif %}
{% endif %}

#define SPEED {{ item.speed }}
#define POWER {{ item.power }}
#define WEIGHT {{ item.weight }}
{% if item.te_coefficient is defined -%}
#define TE_COEFFICIENT {{ item.te_coefficient }}
{%- else %}
#define TE_COEFFICIENT {{ item.te / (item.weight * 9.81) }}
{%- endif %}

{% if units is defined -%}
#define ARTICULATED {{ (units | length) - 1 }}
#define LENGTH {{ units[0].length }}
#define ACTUAL_LENGTH {{ units | map(attribute="length") | sum }}
{% elif gfx.length > 8 %}
#define ARTICULATED {{ gfx.length % 8 }}
#define LENGTH {{ 8 if gfx.length > 8 else gfx.length }}
#define ACTUAL_LENGTH {{ gfx.length }}
{% else %}
#define LENGTH {{ 8 if gfx.length > 8 else gfx.length }}
#define ACTUAL_LENGTH {{ gfx.length }}
{%- endif %}

{% if cargo is defined %}
{% if cargo.capacity is defined %}
#define HEAD_CAPACITY {{ cargo.capacity }}
{% endif %}
{% endif %}

#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC)

{%- if gfx.vfx is defined %}
{%- set vxf_offset = gfx.vfx.offset if gfx.vfx.offset is defined else 0 %}
{%- if item.propulsion == "diesel" %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DIESEL, {{ vxf_offset }}, DISABLE_WAGON_POWER)
{%- elif item.propulsion == "electric_ac" or item.propulsion == "electric_dc" %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, {{ vxf_offset }}, DISABLE_WAGON_POWER)
{%- elif item.propulsion == "steam" %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, {{ vxf_offset }}, DISABLE_WAGON_POWER)
{%- else %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)
{%- endif %}
{%- else %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)
{%- endif %}

#include "../_CodeSupport/item_defaults.pnml"
