/*
* PURCHASE
*/

{% if units.back is defined %}
PURCHASE_SPRITESET_DUALHEADED(VEHIDCODE, "{{ gfx.purchase.filename }}", {{ gfx.purchase.x }}, {{ gfx.purchase.y }})
{% else %}
PURCHASE_SPRITESET(VEHIDCODE, "{{ gfx.purchase.filename }}", {{ gfx.purchase.x }}, {{ gfx.purchase.y }})
{% endif %}

/*
* VEHICLE
*/

{% for spriteset in gfx.spritesets %}
{% if spriteset.forward is defined and spriteset.backward is defined %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_fwd, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.forward.x }}, {{ spriteset.forward.y }})
}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_bwd, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.backward.x }}, {{ spriteset.backward.y }})
}
switch(FEAT_TRAINS, PARENT, spriteset_{{ item.id }}_{{ spriteset.id }}, train_is_driving_backwards) {
    0: spriteset_{{ item.id }}_{{ spriteset.id }}_fwd;
    spriteset_{{ item.id }}_{{ spriteset.id }}_bwd;
}
{% elif spriteset.loading is defined and spriteset.loaded is defined %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_loading, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.loading.x }}, {{ spriteset.loading.y }})
}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_loaded, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.loaded.x }}, {{ spriteset.loaded.y }})
}
spritegroup spriteset_{{ item.id }}_{{ spriteset.id }} {
    loading: spriteset_{{ item.id }}_{{ spriteset.id }}_loading;
    loaded: spriteset_{{ item.id }}_{{ spriteset.id }}_loaded;
}
{% else %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.x }}, {{ spriteset.y }})
}
{% endif %}
{% endfor %}

{% if gfx.extra is defined %}
{{ gfx.extra }}
{% endif %}

{% if gfx.animations is defined %}
{% for animation in gfx.animations %}
switch(FEAT_TRAINS, PARENT, {{ "spriteset_%s_%s" | format(item.id, animation.id) }}, motion_counter % {{ animation.steps | length }}) {
    {% for step in animation.steps %}
    {{ loop.index0 }}: {{ "spriteset_%s_%s" | format(item.id, step) }};
    {% endfor %}
}
{% endfor %}
{% endif %}

{% if gfx.cargosets is defined %}
{% for cargoset in gfx.cargosets %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_{{ cargoset.id }}_cargo, cargo_type_in_veh) {
    {% for option in cargoset.options %}
    {% if option.cargos is defined %}
    {% for cargo in option.cargos %}
    {{ cargo }}: spriteset_{{ item.id }}_{{ option.sprite }};
    {% endfor %}
    {% endif %}
    {% endfor %}
    default: spriteset_{{ item.id }}_{{ cargoset.default.sprite }};
}

switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_{{ cargoset.id }}, cargo_classes) {
    {% for option in cargoset.options %}
    {% if option.bitmask is defined %}
    bitmask({{ option.bitmask }}): spriteset_{{ item.id }}_{{ option.sprite }};
    {% endif %}
    {% endfor %}
    default: switch_{{ item.id }}_{{ cargoset.id }}_cargo;
}
{% endfor %}
{% endif %}

{# Dualheaded engines #}
switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_default, vehicle_is_flipped) {
{% if units.back is defined %}
	1: spriteset_{{ item.id }}_{{ units.back.sprite }};
{% endif %}
    default: spriteset_{{ item.id }}_{{ units.front.sprite }};
}

{# Visual effects for engine #}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_visual_effect_and_powered, vehicle_is_flipped) {
    {% if units.front.vfx is defined %}
	0: visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.front.vfx.offset }}, DISABLE_WAGON_POWER);
    {% else %}
	0: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    {% endif %}
	{% if units.back is defined %}
    {% if units.back.vfx is defined %}
	1: visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.back.vfx.offset }}, DISABLE_WAGON_POWER);
    {% else %}
	1: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    {% endif %}
	{% endif %}
}

{# Visual effects for middle #}
{% if units.middle.vfx is defined and units.middle.vfx.custom is defined %}
{{ units.middle.vfx.custom }}
{% endif %}
{% if units.middle.powered is defined and units.middle.powered.vfx is defined %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_wagon_powered_visual_effect_and_powered, vehicle_is_flipped) {
	visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.middle.powered.vfx.offset }}, DISABLE_WAGON_POWER);
}
{% endif %}

/*
* Cargo capacity
*/

ENGINECAPACITYSWITCH(VEHIDCODE)

WAGONCAPACITYSWITCH(VEHIDCODE)

//Add defined switches

RUNNINGCOSTENGINESWITCH

RUNNINGCOSTMUWAGONSWITCH

EXPANDEDPURCHASETEXTSWITCH(VEHIDCODE)

