{% extends "../train.pnml.j2" %}

{% block properties_extra %}
{{ super() }}

#define LOADINGSPEED {{ cargo.loading_speed }}
#define CARGODEF {{ cargo.cargodef }}

#define HEAD_CAPACITY  {{ units[0].capacity }}

#define ARTICULATED {{ (units | length) - 1 }}
#define LENGTH {{ units[0].length }}
#define WAGON_LENGTH {{ units[0].length }}

#define DUAL_HEADED {{ 1 if units.back is defined else 0 }}
#define PASSENGER   1
#define MISC_FLAGS bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_2CC)

{%- if units[0].vfx is defined %}
#define VISUAL_FLAG visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units[0].vfx.offset }}, DISABLE_WAGON_POWER)
{%- else %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)
{%- endif %}

{% endblock properties_extra %}


{% block switches %}
{{ super() }}
ENGINECAPACITYSWITCH(VEHIDCODE)
{# WAGONCAPACITYSWITCH(VEHIDCODE) #}
{% endblock switches %}

{% block item_graphics %}
{{ super() }}
ENGINECAPACITYSWITCHCALL(VEHIDCODE)
default: spriteset_{{ item.id }}_default;
{# visual_effect_and_powered: switch_{{ item.id }}_visual_effect_and_powered; #}
{% endblock item_graphics %}
