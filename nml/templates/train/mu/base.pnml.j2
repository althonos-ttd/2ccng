{% extends "../train.pnml.j2" %}

{% block properties_extra %}
{{ super() }}

#define LOADINGSPEED {{ cargo.loading_speed }}
#define CARGODEF {{ cargo.cargodef }}

#define HEAD_CAPACITY  {{ units.front.capacity }}
#define WAGON_CAPACITY {{ units.middle.capacity }}

#define LENGTH {{ units.front.length }}
#define WAGON_LENGTH {{ units.middle.length }}

#define DUAL_HEADED {{ 1 if units.back is defined else 0 }}
#define PASSENGER   1
#define MISC_FLAGS bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_2CC)

{%- if gfx.vfx is defined %}
#define VISUAL_FLAG visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ gfx.vfx.offset }}, DISABLE_WAGON_POWER)
{%- else %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)
{%- endif %}

{% endblock properties_extra %}

{% block graphics%}

{% block graphics_purchase %}
{% if units.back is defined %}
PURCHASE_SPRITESET_DUALHEADED(VEHIDCODE, "{{ gfx.purchase.filename }}", {{ gfx.purchase.x }}, {{ gfx.purchase.y }})
{% else %}
PURCHASE_SPRITESET(VEHIDCODE, "{{ gfx.purchase.filename }}", {{ gfx.purchase.x }}, {{ gfx.purchase.y }})
{% endif %}
{% endblock graphics_purchase %}

{{ self.graphics_spritesets() }}
{{ self.graphics_extra() }}
{{ self.graphics_animations() }}
{{ self.graphics_cargosets() }}

{# Dualheaded engines #}
switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_default, vehicle_is_flipped) {
{% if units.back is defined %}
	1: spriteset_{{ item.id }}_{{ units.back.sprite }};
{% endif %}
    default: spriteset_{{ item.id }}_{{ units.front.sprite }};
}

{# Visual effects for engine #}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_visual_effect_and_powered, vehicle_is_flipped) {
    {% if units.front.vfx is defined %}
	0: visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.front.vfx.offset }}, DISABLE_WAGON_POWER);
    {% else %}
	0: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    {% endif %}
	{% if units.back is defined %}
    {% if units.back.vfx is defined %}
	1: visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.back.vfx.offset }}, DISABLE_WAGON_POWER);
    {% else %}
	1: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    {% endif %}
	{% endif %}
}

{# Visual effects for middle #}
{% if units.middle.vfx is defined and units.middle.vfx.custom is defined %}
{{ units.middle.vfx.custom }}
{% endif %}
{% if units.middle.powered is defined and units.middle.powered.vfx is defined %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_wagon_powered_visual_effect_and_powered, vehicle_is_flipped) {
	visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ units.middle.powered.vfx.offset }}, DISABLE_WAGON_POWER);
}
{% endif %}

{% endblock graphics %}

{% block switches %}
{{ super() }}
ENGINECAPACITYSWITCH(VEHIDCODE)
WAGONCAPACITYSWITCH(VEHIDCODE)
RUNNINGCOSTMUWAGONSWITCH
{% endblock switches %}

{% block item_graphics %}
{{ super() }}
ENGINECAPACITYSWITCHCALL(VEHIDCODE)
visual_effect_and_powered: switch_{{ item.id }}_visual_effect_and_powered;
default: spriteset_{{ item.id }}_default;
{% endblock item_graphics %}

{% block item_extra %}
	livery_override (item_mu_narrow_wagon_unpowered ) {
		LOADINGSPEEDPROPERTY
		RUNNINGCOSTMUWAGONUNPOWEREDSWITCHCALL
		weight: WEIGHTMUWAGONUNPOWERED
		WAGONCAPACITYSWITCHCALL(VEHIDCODE)
		length: WAGON_LENGTH;
		{% if units.middle.vfx is defined and units.middle.vfx %}
		visual_effect_and_powered: switch_{{ item.id }}_wagon_visual_effect_and_powered;
		{% endif %}
        {% if units.middle.unpowered is defined %}
		default: spriteset_{{ item.id }}_{{ units.middle.unpowered.sprite }};
        {% else %}
		default: spriteset_{{ item.id }}_{{ units.middle.sprite }};
        {% endif %}
	}
	livery_override (item_mu_narrow_wagon_powered ) {
		LOADINGSPEEDPROPERTY
		RUNNINGCOSTMUWAGONPOWEREDSWITCHCALL
		power: POWERMUWAGONPOWERED
		weight: WEIGHTMUWAGONPOWERED
		{% if units.middle.powered is defined and units.middle.powered.vfx is defined %}
		visual_effect_and_powered: switch_{{ item.id }}_wagon_powered_visual_effect_and_powered;
		{% elif units.middle.vfx is defined and units.middle.vfx %}
		visual_effect_and_powered: switch_{{ item.id }}_wagon_visual_effect_and_powered;
		{% endif %}
		WAGONCAPACITYSWITCHCALL(VEHIDCODE)
		tractive_effort_coefficient: TEMUWAGONPOWERED
		length: WAGON_LENGTH;
		{% if units.middle.powered is defined %}
		default: spriteset_{{ item.id }}_{{ units.middle.powered.sprite }};
        {% else %}
		default: spriteset_{{ item.id }}_{{ units.middle.sprite }};
        {% endif %}
	}
{% endblock item_extra %}
