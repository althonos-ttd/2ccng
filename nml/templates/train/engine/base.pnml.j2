{% extends "../train.pnml.j2" %}

{% block properties_extra %}

#define ARTICULATED {{ (units | length) - 1 }}
#define LENGTH {{ [units[0].length, 8] | min }}
#define ACTUAL_LENGTH {{ units | map(attribute="length") | sum }}

#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC)
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)

{% endblock properties_extra %}

{% block graphics_default %}
{% with n_units = units | length %}
{% block graphics_articulated %}
{% if n_units > 1 %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_length, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {{ loop.index0 }}: {{ unit.length }};
    {% endfor %}
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_articulated, extra_callback_info1) {
    1..{{ n_units - 1 }}: item_{{ item.id }};
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
{% endif %}
{% endblock graphics_articulated %}
{{ super() }}
{% endwith %}
{% endblock graphics_default %}

{% block graphics_vfx %}
{% with n_units = units | length %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_visual_effect, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {% if unit.vfx is defined %}
    {{ loop.index0 }}: return visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ unit.vfx.offset }}, DISABLE_WAGON_POWER);
    {% endif %}
    {% endfor %}
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
{% endwith %}
{% endblock graphics_vfx %}
 
{% block item_property %}
{{ super() }}
{% with n_units = units | length %}
{% if n_units == 1 %}
length: {{ units[0].length }};
{% endif %}
{% endwith %}
{% endblock %}

{% block item_graphics %}
{% with n_units = units | length %}
{{ super() }}
default: switch_{{ item.id }}_default;
visual_effect_and_powered: switch_{{ item.id }}_visual_effect;
{% if n_units > 1 %}
articulated_part: switch_{{ item.id }}_articulated;
length: switch_{{ item.id }}_length;
{% endif %}
{% endwith %}
{% endblock item_graphics %}

