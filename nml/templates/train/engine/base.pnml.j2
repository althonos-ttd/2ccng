{% extends "../train.pnml.j2" %}

{% block properties_extra %}

#define ARTICULATED {{ (units | length) - 1 }}
#define LENGTH {{ [units[0].length, 8] | min }}
#define ACTUAL_LENGTH {{ units | map(attribute="length") | sum }}

#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC)

{%- if gfx.vfx is defined %}
{%- set vfx_offset = gfx.vfx.offset if gfx.vfx.offset is defined else 0 %}
#define VISUAL_FLAG visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ vfx_offset }}, DISABLE_WAGON_POWER)
{%- else %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)
{%- endif %}

{% endblock properties_extra %}

{% block graphics_extra %}

{# Add special definitions for articulated engines #}

{% set n_units = units | length %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_length, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {{ loop.index0 }}: {{ unit.length }};
    {% endfor %}
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_articulated, extra_callback_info1) {
    1..{{ n_units - 1 }}: item_{{ item.id }};
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_default, position_in_vehid_chain % {{ n_units }}) {
	{% for unit in units %}
    {% if unit.sprite is defined %}
    {{ loop.index0 }}: spriteset_{{ item.id }}_{{ unit.sprite }};
    {% endif %}
    {% endfor %}
	EMPTY_SPRITESET
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_visual_effect, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {% if unit.vfx is defined %}
    {{ loop.index0 }}: return visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ unit.vfx.offset }}, DISABLE_WAGON_POWER);
    {% endif %}
    {% endfor %}
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

{# Add special definitions for longer vehicles #}
{#{% if gfx.length is defined and gfx.length > 8 and units is not defined %}
{% set n_units = (gfx.length + 7) // 8 %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_length, position_in_vehid_chain % {{ n_units }}) {
    {% for i in range(gfx.length // 8) %}
    {{ loop.index0 }}: {{ 8 }};
    {% endfor %}
    {{ gfx.length % 8 }};
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_articulated, extra_callback_info1) {
    1..{{ n_units - 1 }}: item_{{ item.id }};
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_default, position_in_vehid_chain % 2) {
	0: spriteset_{{ item.id }}_default;
	EMPTY_SPRITESET
}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_visual_effect, position_in_vehid_chain % {{ n_units }}) {
    0: return visual_effect_and_powered({{ VISUAL_EFFECT }}, {{ gfx.vfx.offset if gfx.vfx.offset is defined else 0 }}, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
{% endif %}#}

{{ super() }}
{% endblock graphics_extra %}

{% block item_graphics %}
{{ super() }}

{% if units is defined or gfx.length > 8 %}
default: switch_{{ item.id }}_default;
visual_effect_and_powered: switch_{{ item.id }}_visual_effect;
articulated_part: switch_{{ item.id }}_articulated;
length: switch_{{ item.id }}_length;
{% else %}
default: spriteset_{{ item.id }}_default;
{% endif %}

{% endblock item_graphics %}

