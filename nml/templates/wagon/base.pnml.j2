#include "../undefine_properties.pnml"

{% set VISUAL_EFFECT = "VISUAL_EFFECT_DISABLE" %}
{% set RUNNING_COST_BASE = "RUNNING_COST_DIESEL" %}
{% set ENGINE_CLASS = "ENGINE_CLASS_DIESEL" %}
{% set TRACK_TYPE = "NARR" %}

{% block properties %}

#define VEHIDCODE {{ item.id }}
#define ITEM item_{{ item.id }}
#define NAME string(str_{{ item.id }})

#define VEHICLE_REGION REGION(ALLREGION,NOREGION,NOCONCEPT)

#define INTRODUCTION_YEAR {{ item.life.start }}
{%- if item.life.end is defined %}
#define MODEL_LIFE {{ item.life.end - item.life.start }}
{%- else %}
#define MODEL_LIFE VEHICLE_NEVER_EXPIRES
{%- endif %}
#define RETIRE_EARLY DEFAULT_RETIRE_EARLY
#define VEHICLE_LIFE 40

#define LOADINGSPEED {{ cargo.loading_speed }}
#define CARGODEF {{ cargo.cargodef }}

#define SPEED {{ item.speed }}
#define WEIGHT {{ item.weight }}
#define AIR_DRAG_COEFFICIENT 0

#define LENGTH {{ units.wagon.length }}
#define ACTUAL_LENGTH {{ units.wagon.length }}
#define HEAD_CAPACITY {{ units.wagon.capacity }}

#define DUAL_HEADED 0
#define PASSENGER 1
{% if cargo.autorefit is defined and cargo.autorefit %}
#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_AUTOREFIT)
{% else %}
#define MISC_FLAGS bitmask(TRAIN_FLAG_2CC)
{% endif %}
#define VISUAL_FLAG visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER)

#define TRACK_TYPE CURRENT_TRACK_TYPE
#define ENGINE_CLASS CURRENT_ENGINE_CLASS
#define RUNNING_COST_BASE CURRENT_RUNNING_COST_BASE

#define REFIT_COST DEFAULT_REFIT_COST
#define RELIABILITY_DECAY DEFAULT_RELIABILITY_DECAY
{% if cargo.age_period is defined %}
#define CARGO_AGE_PERIOD {{ cargo.age_period }}
{% else %}
#define CARGO_AGE_PERIOD DEFAULT_CARGO_AGE_PERIOD
{% endif %}
#define POWER_PER_WAGON DEFAULT_POWER_PER_WAGON
#define BITMASK_VEHICLE_INFO DEFAULT_BITMASK
#define SPRITE_ID DEFAULT_SPRITE_ID

{% endblock properties %}

{% block graphics %}

/*
* PURCHASE
*/

{% block graphics_purchase %}
spriteset(spriteset_{{ item.id }}_purchase_wagon_flag_only, "{{ gfx.purchase.filename }}") {
    template_purchase_wagon_flag_only({{ gfx.purchase.x }}, {{ gfx.purchase.y }})
}
spriteset(spriteset_{{ item.id }}_purchase_wagon_none, "{{ gfx.purchase.filename }}") {
    template_purchase_wagon_none({{ gfx.purchase.x }}, {{ gfx.purchase.y }})
}
switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_purchase, param_purchaseinfo) {
    0: spriteset_{{ item.id }}_purchase_wagon_none;
    1: spriteset_{{ item.id }}_purchase_wagon_flag_only;
    2: spriteset_{{ item.id }}_purchase_wagon_flag_only;
}
{% endblock graphics_purchase %}

/*
* Vehicle
*/

{% block graphics_spritesets %}
{% for spriteset in gfx.spritesets %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.x }}, {{ spriteset.y }})
}
{% endfor %}
{% endblock graphics_spritesets %}

{% block graphics_loadsets %}
{% if gfx.loadsets is defined %}
{% for loadset in gfx.loadsets %}
spritegroup spriteset_{{ item.id }}_{{ loadset.id }} {
    loading: [
        {% for stage in loadset.loading %}spriteset_{{ item.id }}_{{ stage }}{% if not loop.last %},{% endif %}{% endfor %}
    ];
    loaded: [
        {% for stage in loadset.loaded %}spriteset_{{ item.id }}_{{ stage }}{% if not loop.last %},{% endif %}{% endfor %}
    ];
}
{% endfor %}
{% endif %}
{% endblock graphics_loadsets %}

{% block graphics_animations %}
{% if gfx.animations is defined %}
{% for animation in gfx.animations %}
switch(FEAT_TRAINS, PARENT, spriteset_{{ item.id }}_{{ animation.id }}, motion_counter % {{ animation.steps | length }}) {
    {% for step in animation.steps %}
    {{ loop.index0 }}: spriteset_{{ item.id }}_{{ step }};
    {% endfor %}
}
{% endfor %}
{% endif %}
{% endblock graphics_animations %}

{% block graphics_cargosets %}
{% if gfx.cargosets is defined %}
{% for cargoset in gfx.cargosets %}
switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_{{ cargoset.id }}_cargo, cargo_type_in_veh) {
    {% for option in cargoset.options %}
    {% if option.cargos is defined %}
    {% for cargo in option.cargos %}
    {{ cargo }}: spriteset_{{ item.id }}_{{ option.sprite }};
    {% endfor %}
    {% endif %}
    {% endfor %}
    default: spriteset_{{ item.id }}_{{ cargoset.default.sprite }};
}
switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_{{ cargoset.id }}, cargo_classes) {
    {% for option in cargoset.options %}
    {% if option.bitmask is defined %}
    bitmask({{ option.bitmask }}): spriteset_{{ item.id }}_{{ option.sprite }};
    {% endif %}
    {% endfor %}
    default: switch_{{ item.id }}_{{ cargoset.id }}_cargo;
}
{% endfor %}
{% endif %}
{% endblock graphics_cargosets %}

{% block graphics_randomize %}
{% if gfx.randomize is defined %}
{% for randomset in gfx.randomize %}
random_switch(FEAT_TRAINS, SELF, spriteset_{{ item.id }}_{{ randomset.id }}) {
    {% for sprite in randomset.options %}
    {{ randomset.options[sprite] }}: spriteset_{{ item.id }}_{{ sprite }};
    {%- endfor %}
}
{% endfor %}
{% endif %}
{% endblock graphics_randomize %}

{% block graphics_vfx %}
{% endblock graphics_vfx %}

{% block graphics_extra %}
{% if gfx.extra is defined %}
{{ gfx.extra }}
{% endif %}
{% endblock graphics_extra %}

{% block graphics_default %}
random_switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_default) {
    1: spriteset_{{ item.id }}_{{ units.wagon.sprite }};
}
{% endblock graphics_default %}

{% endblock graphics %}


//Add defined switches

{% block switches %}
RUNNINGCOSTENGINESWITCH

switch(FEAT_TRAINS, SELF, switch_{{ item.id }}_capacity_wagon, cargo_classes) {
    bitmask(CC_MAIL): HEAD_CAPACITY/2;
    bitmask(CC_ARMOURED): HEAD_CAPACITY/4;
    HEAD_CAPACITY;
}
{% endblock %}

{% block item %}

item(FEAT_TRAINS, ITEM ) {
	property {
        {% block item_property %}
		name: NAME;
        climates_available: ALL_CLIMATES;
		INTRODUCTIONDATEPROPERTY
		model_life: MODEL_LIFE;
		vehicle_life: VEHICLE_LIFE;
		retire_early: RETIRE_EARLY;

        {% include "../_common/loadingspeeddef.pnml.j2" %}

		PURCHASECOSTPROPERTY
		RUNNINGCOSTPROPERTY
		speed: SPEED km/h;
		cargo_capacity: HEAD_CAPACITY;
		weight: WEIGHT ton;

		reliability_decay: RELIABILITY_DECAY;

        {% include "../_common/cargodef.pnml.j2" %}

		cargo_age_period: CARGO_AGE_PERIOD;
		misc_flags: MISC_FLAGS;
		refit_cost: REFIT_COST;
        track_type: {{ TRACK_TYPE }};
        AIFLAGPROPERTY
        running_cost_base: {{ RUNNING_COST_BASE }};
        engine_class: {{ ENGINE_CLASS }};
		visual_effect_and_powered: VISUAL_FLAG;

		sprite_id: SPRITE_ID;
		dual_headed: DUAL_HEADED;
		length: LENGTH;
		extra_power_per_wagon: POWER_PER_WAGON;
		bitmask_vehicle_info: BITMASK_VEHICLE_INFO;
        badges: [
            {% block item_badges %}
            {% if item.gauge is defined %}
            "railgauge/narrow/{{ item.gauge }}",
            {% endif %}
            {% if item.builders is defined %}
            {% for builder in item.builders -%}
            "builder/{{ builder }}",
            {%- endfor %}
            {% endif %}
            {% endblock item_badges %}
        ];
        {% endblock item_property %}
	}
	graphics {
        {% block item_graphics %}
		purchase: spriteset_{{ item.id }}_purchase;
        cargo_capacity: switch_{{ item.id }}_capacity_wagon;
		RUNNINGCOSTENGINESWITCHCALL
		default: switch_{{ item.id }}_default;
        {% endblock item_graphics %}
	}
    {% block item_extra %}
    {% endblock item_extra%}
}

{% endblock item %}
