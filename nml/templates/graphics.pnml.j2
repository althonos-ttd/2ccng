/*
* PURCHASE
*/

PURCHASE_SPRITESET(VEHIDCODE, "{{ gfx.purchase.filename }}", {{ gfx.purchase.x }}, {{ gfx.purchase.y }})

/*
* VEHICLE
*/

{% for spriteset in gfx.spritesets %}
{% if spriteset.forward is defined and spriteset.backward is defined %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_fwd, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.forward.x }}, {{ spriteset.forward.y }})
}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}_bwd, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.backward.x }}, {{ spriteset.backward.y }})
}
switch(FEAT_TRAINS, PARENT, spriteset_{{ item.id }}_{{ spriteset.id }}, train_is_driving_backwards) {
    0: spriteset_{{ item.id }}_{{ spriteset.id }}_fwd;
    spriteset_{{ item.id }}_{{ spriteset.id }}_bwd;
}
{% else %}
spriteset(spriteset_{{ item.id }}_{{ spriteset.id }}, {{ spriteset.filename|tojson }}) {
    {{ spriteset.template }}({{ spriteset.x }}, {{ spriteset.y }})
}
{% endif %}
{% endfor %}

{% if gfx.animations is defined %}
{% for animation in gfx.animations %}
switch(FEAT_TRAINS, PARENT, {{ "spriteset_%s_%s" | format(item.id, animation.id) }}, motion_counter % {{ animation.steps | length }}) {
    {% for step in animation.steps %}
    {{ loop.index0 }}: {{ "spriteset_%s_%s" | format(item.id, step) }};
    {% endfor %}
}
{% endfor %}
{% endif %}

{# Add special definitions for articulated engines #}
{% if units is defined %}
{% set n_units = units | length %}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_length" | format(item.id) }}, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {{ loop.index0 }}: {{ unit.length }};
    {% endfor %}
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_articulated" | format(item.id) }}, extra_callback_info1) {
    1..{{ n_units - 1 }}: {{ "item_%s" | format(item.id) }};
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_default" | format(item.id) }}, position_in_vehid_chain % {{ n_units }}) {
	{% for unit in units %}
    {{ loop.index0 }}: {{ "spriteset_%s_%s" | format(item.id, unit.sprite) }};
    {% endfor %}
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_visual_effect" | format(item.id) }}, position_in_vehid_chain % {{ n_units }}) {
    {% for unit in units %}
    {% if unit.vfx is defined %}
    {{ loop.index0 }}: return visual_effect_and_powered({{ unit.vfx.type if unit.vfx.type is defined else "VISUAL_EFFECT_DISABLE" }}, {{ unit.vfx.offset if unit.vfx.offset is defined else 0 }}, DISABLE_WAGON_POWER);
    {# {% else %} #}
    {# {{ loop.index0 }}: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER); #}
    {% endif %}
    {% endfor %}
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
{% endif %}

{# Add special definitions for longer vehicles #}
{% if gfx.length is defined and gfx.length > 8 and units is not defined %}
{% set n_units = (gfx.length + 7) // 8 %}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_length" | format(item.id) }}, position_in_vehid_chain % {{ n_units }}) {
    {% for i in range(gfx.length // 8) %}
    {{ loop.index0 }}: {{ 8 }};
    {% endfor %}
    {{ gfx.length % 8 }};
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_articulated" | format(item.id) }}, extra_callback_info1) {
    1..{{ n_units - 1 }}: {{ "item_%s" | format(item.id) }};
    CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_default" | format(item.id) }}, position_in_vehid_chain % 2) {
	0: {{ "spriteset_%s_default" | format(item.id) }};
	EMPTY_SPRITESET
}
switch(FEAT_TRAINS, SELF, {{ "switch_%s_visual_effect" | format(item.id) }}, position_in_vehid_chain % {{ n_units }}) {
    0: return visual_effect_and_powered({{ gfx.vfx.type if gfx.vfx.type is defined else "VISUAL_EFFECT_DISABLE" }}, {{ gfx.vfx.offset if gfx.vfx.offset is defined else 0 }}, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}
{% endif %}

{% if gfx.extra is defined %}
{{ gfx.extra }}
{% endif %}

//Add defined switches

RUNNINGCOSTENGINESWITCH

EXPANDEDPURCHASETEXTSWITCH(VEHIDCODE)
